.bio p{margin:0 0 17px}.bio p:last-child{margin-bottom:0}
.section-title{font-family:Georgia,"Times New Roman",serif;font-size:32px;font-weight:500;letter-spacing:-.025em;line-height:1.3;color:var(--ink);margin:0 0 21px}
section:not(.hero){scroll-margin-top:30px}
.research{padding-top:54px}
