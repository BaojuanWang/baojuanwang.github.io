.name-cn{font-size:25px;font-weight:400;margin:18px 0 25px;color:#334c43;font-family:Georgia,"Noto Serif CJK SC","Songti SC",serif;letter-spacing:.05em;line-height:1.3}
.position{font-size:13px;line-height:1.6;color:#45584d;margin-bottom:16px;max-width:280px}
.quick-links{font-size:13px;display:flex;gap:15px;flex-wrap:wrap}
.quick-links a{border:0;border-bottom:1px solid #a4b5b1;color:#2c5659}
