<div class="mini-quiz" hidden="" id="vs-quiz">
<p><strong>Quick check</strong></p>
<p>Why do parameterized queries help?</p>
<button data-correct="no" type="button">They remove every special character.</button>
<button data-correct="yes" type="button">They separate values from SQL commands.</button>
<p aria-live="polite" class="quiz-feedback"></p>
</div>
</aside>
</div>
</div>
</div>
<div class="dialog-foot">This is a simplified, AI-assisted preview based on our paper. Since it is not connected to a live API, we included a few example questions and responses to demonstrate selected features. These examples are for illustration only, not actual study conversations.</div>
</dialog>

<footer class="footer"><div class="wrapper">© Baojuan Wang</div></footer>
<script>
document.getElementById('ccs-art').src='data:image/svg+xml;base64,';
document.getElementById('lure-art').src='data:image/svg+xml;base64,';



(function(){
  let lastTrigger = null;
  const ccs = document.getElementById('detail-ccs');
  document.querySelectorAll('[data-modal]').forEach(el => el.addEventListener('click', () => {
    lastTrigger = el;
    const dlg = document.getElementById('detail-' + el.dataset.modal);
    if (dlg && !dlg.open) {
      if (dlg === ccs) resetConversation();
      dlg.showModal();
    }
  }));
  document.querySelectorAll('.detail-dialog').forEach(dlg => {
    dlg.querySelector('.close-detail').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => lastTrigger?.focus());
  });

  const replies = {
    fix: {
      q: 'How do I fix this vulnerability?',
      lead: 'Before showing a fix, look at why the original query is vulnerable.',
      focus: 'understand',
      sections: {
        understand: ['Why this happens', 'When user input is inserted directly into SQL text, the database can interpret it as part of the command.'],
        behavior: ['At runtime', 'The database parses the assembled query. Untrusted input can change the intended command.'],
        danger: ['Potential consequences', 'Depending on database permissions, an altered query may expose or change records.'],
        fix: ['Safer approach', 'Use parameterized queries to separate input values from SQL syntax.']
      }
    },
    cause: {
      q: 'Why is this vulnerable?',
      lead: 'The problem is that untrusted input can become part of the SQL command.',
      focus: 'understand',
      sections: {
        understand: ['The root cause', 'String concatenation can mix user-provided values with SQL instructions instead of treating the values only as data.'],
        behavior: ['What the database sees', 'The database parses the combined string as SQL and may interpret unexpected input as syntax.'],
        danger: ['Possible impact', 'If the statement changes meaning, the database may return or modify unintended records.'],
        fix: ['What to change', 'Bind user-provided values as parameters rather than adding them to a SQL string.']
      }
    },
    behavior: {
      q: 'What happens at runtime?',
      lead: 'Consider what the database actually receives after the application builds the query.',
      focus: 'behavior',
      sections: {
        understand: ['Before execution', 'The application assembles its SQL text with the input it received.'],
        behavior: ['When it runs', 'If the input is parsed as SQL code, the resulting command can behave differently from what the developer intended.'],
        danger: ['Possible result', 'The modified statement may retrieve or alter unintended data, depending on privileges.'],
        fix: ['Avoid the ambiguity', 'Use parameters so that data is never parsed as part of the SQL command.']
      }
    },
    danger: {
      q: 'What could go wrong?',
      lead: 'The impact depends on the database permissions and the statement being executed.',
      focus: 'danger',
      sections: {
        understand: ['Source of the risk', 'Untrusted input can influence a SQL command when data and command text are combined.'],
        behavior: ['During execution', 'The parsed query may be different from the original intended query.'],
        danger: ['Security consequences', 'Possible effects include revealing sensitive information, changing records, or bypassing an intended check.'],
        fix: ['Reduce the risk', 'Use parameterized queries and grant the application only the privileges it needs.']
      }
    }
  };
  const thread = ccs.querySelector('#vs-thread');
  const history = ccs.querySelector('#vs-history');
  const clear = ccs.querySelector('#vs-clear');
  const quiz = ccs.querySelector('#vs-quiz');
  const quizToggle = ccs.querySelector('.aside-toggle');
  let activeTurn = null;
  let turnCount = 0;

  function resetConversation(){
    thread.replaceChildren();
    const hint = document.createElement('div');
    hint.className = 'vs-empty';
    hint.id = 'vs-empty';
    hint.textContent = 'Select a question below to start.';
    thread.appendChild(hint);
    history.replaceChildren();
    const p = document.createElement('p'); p.className='vs-history-empty'; p.textContent='No questions yet.';
    history.appendChild(p);
    clear.hidden = true;
    activeTurn = null; turnCount=0;
    ccs.querySelectorAll('.section-link').forEach(el => el.disabled=true);
    quizToggle.disabled=true;
    quizToggle.setAttribute('aria-expanded','false');
    quiz.hidden=true;
    quiz.querySelector('.quiz-feedback').textContent='';
  }
  function openTopic(turn, topic){
    if (!turn) return;
    const section=turn.querySelector('.vs-section[data-topic="'+topic+'"]');
    if (!section) return;
    turn.querySelectorAll('.vs-section').forEach(el => {
      const expanded = el===section;
      el.classList.toggle('open', expanded);
      el.querySelector('button').setAttribute('aria-expanded',String(expanded));
      el.querySelector('.chevron').textContent=expanded?'−':'+';
      el.querySelector('p').hidden=!expanded;
    });
  }
  function setActiveTurn(turn){
    activeTurn=turn;
    history.querySelectorAll('.vs-history-item').forEach(el => {
      el.classList.toggle('active',el.dataset.turn===turn.id);
      el.setAttribute('aria-current',el.dataset.turn===turn.id?'true':'false');
    });
  }
  function selectPreset(key){
    const sample=replies[key]; if(!sample)return;
    const empty=thread.querySelector('.vs-empty'); if(empty)empty.remove();
    const historyEmpty=history.querySelector('.vs-history-empty'); if(historyEmpty)historyEmpty.remove();
    if (!thread.querySelector('.vs-example-code')) {
      const codeBox = document.createElement('div');
      codeBox.className = 'vs-example-code';
      const head = document.createElement('div'); head.className = 'vs-example-head'; head.textContent = 'Example code · SQL injection';
      const code = document.createElement('pre');
      // textContent ensures this is displayed as code, never interpreted as HTML or executed.
      const line1 = document.createTextNode('id = request.args["id"]\n');
      const risky = document.createElement('span'); risky.className = 'bad-line';
      risky.textContent = 'sql = "SELECT * FROM users WHERE id = " + id';
      code.append(line1,risky);
      codeBox.append(head,code);
      thread.append(codeBox);
    }
    turnCount++;
    const turn=document.createElement('div');turn.className='vs-turn';turn.id='vs-turn-'+turnCount;
    const question=document.createElement('div'); question.className='vs-user';question.textContent=sample.q;
    const author=document.createElement('p');author.className='vs-assistant-title';author.textContent='VulnScaffold';
    const lead=document.createElement('p');lead.className='vs-lead';lead.textContent=sample.lead;
    turn.append(question,author,lead);
    for(const [topic,parts] of Object.entries(sample.sections)){
      const row=document.createElement('div');row.className='vs-section';row.dataset.topic=topic;
      const btn=document.createElement('button');btn.type='button';btn.setAttribute('aria-expanded','false');
      const name=document.createElement('span');name.className='topic-name';name.textContent=parts[0];
      const chevron=document.createElement('span');chevron.className='chevron';chevron.textContent='+';
      btn.append(name,chevron);
      const p=document.createElement('p');p.hidden=true;p.textContent=parts[1];
      row.append(btn,p);turn.appendChild(row);
      btn.addEventListener('click',()=>{
        setActiveTurn(turn);
        if(row.classList.contains('open')){
          row.classList.remove('open');btn.setAttribute('aria-expanded','false');p.hidden=true;chevron.textContent='+';
        } else openTopic(turn,topic);
      });
    }
    thread.appendChild(turn);
    const historyBtn=document.createElement('button');historyBtn.type='button';historyBtn.className='vs-history-item';historyBtn.dataset.turn=turn.id;historyBtn.textContent=sample.q;
    historyBtn.addEventListener('click',()=>{
      setActiveTurn(turn);
      const offset=turn.offsetTop-thread.offsetTop;
      thread.scrollTo({top:offset,behavior:'smooth'});
    });
    history.appendChild(historyBtn);
    setActiveTurn(turn);
    openTopic(turn,sample.focus);
    clear.hidden=false;
    ccs.querySelectorAll('.section-link').forEach(el=>el.disabled=false);
    quizToggle.disabled=false;
    thread.scrollTop = turnCount === 1 ? 0 : thread.scrollHeight;
  }
  ccs.querySelectorAll('[data-preset]').forEach(el => el.addEventListener('click',()=>selectPreset(el.dataset.preset)));
  clear.addEventListener('click',resetConversation);
  ccs.querySelectorAll('.section-link').forEach(el => el.addEventListener('click',()=>{
    if(!activeTurn)return;
    openTopic(activeTurn,el.dataset.topic);
    const target=activeTurn.querySelector('.vs-section[data-topic="'+el.dataset.topic+'"]');
    if(target){thread.scrollTo({top:target.offsetTop-thread.offsetTop-50,behavior:'smooth'});}
  }));
  quizToggle.addEventListener('click',()=>{
    if(quizToggle.disabled)return;
    quiz.hidden=!quiz.hidden;
    quizToggle.setAttribute('aria-expanded',String(!quiz.hidden));
  });
  ccs.querySelectorAll('.mini-quiz button').forEach(el => el.addEventListener('click',()=>{
    ccs.querySelector('.quiz-feedback').textContent = el.dataset.correct==='yes'
      ? 'Correct. Parameters keep input separate from SQL syntax.'
      : 'Try again. The key is separating data from commands.';
  }));
})();
</script>
</body></html>