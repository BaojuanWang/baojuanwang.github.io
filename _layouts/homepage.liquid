<!doctype html>


<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>Baojuan Wang (王宝娟)</title>
<style>
:root{--paper:#fcfbf8;--ink:#15241f;--body:#24332d;--sub:#344941;--line:#dadfd9;--link:#174c56;--rust:#b76a53}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--body);font-family:Lato,"Avenir Next",Arial,sans-serif;-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.8}
a{color:var(--link);text-decoration:none;border-bottom:1px solid #9ab3ae;text-underline-offset:3px}
a:hover{color:#17444c;border-color:currentColor}
.site-header{border-bottom:1px solid var(--line);background:var(--paper)}
.wrapper{max-width:1144px;margin:0 auto;padding-left:48px;padding-right:48px}
.navbar{min-height:75px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.wordmark{border:0;font-family:Georgia,"Times New Roman",serif;font-size:23px;font-weight:700;letter-spacing:-.025em;color:var(--ink)}
.navigation{display:flex;gap:29px;font-size:13px;align-items:center}
.navigation a{border:0;color:#384b43}.navigation a:hover{color:var(--ink)}
.main{padding-top:76px;padding-bottom:60px}
.hero{display:grid;grid-template-columns:320px minmax(0,1fr);column-gap:70px;align-items:start;padding-bottom:65px;border-bottom:1px solid var(--line)}
.hero-title{margin:1px 0 0;color:var(--ink);font-size:49px;line-height:1.12;font-family:Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:-.045em}
.name-cn{font-size:25px;font-weight:400;margin:18px 0 25px;color:#314a3f;font-family:Georgia,"Noto Serif CJK SC","Songti SC",serif;letter-spacing:.05em;line-height:1.3}
.position{font-size:13px;line-height:1.6;color:#394e44;margin-bottom:16px;max-width:280px}
.quick-links{font-size:13px;display:flex;gap:15px;flex-wrap:wrap}
.quick-links a{border:0;border-bottom:1px solid #a4b5b1;color:#174c56}
.bio{padding-top:2px;max-width:665px;font-size:15px;color:var(--body)}
.bio p{margin:0 0 17px}.bio p:last-child{margin-bottom:0}
.section-title{font-family:Georgia,"Times New Roman",serif;font-size:32px;font-weight:500;letter-spacing:-.025em;line-height:1.3;color:var(--ink);margin:0 0 21px}
section:not(.hero){scroll-margin-top:30px}
.research{padding-top:54px}
.work{display:grid;grid-template-columns:minmax(0,1fr) 455px;gap:51px;align-items:center;padding:31px 0 46px;border-bottom:1px solid var(--line)}
.work + .work{grid-template-columns:455px minmax(0,1fr);padding:47px 0 28px;border-bottom:0}
.work--reverse .work-content{grid-column:2;grid-row:1}
.work--reverse .work-art{grid-column:1;grid-row:1}
.publication-year{font-size:12px;line-height:1.5;letter-spacing:.05em;color:#375348;font-weight:700;margin:0 0 11px}
.work-title{font-family:Georgia,"Times New Roman",serif;font-size:24px;font-weight:500;line-height:1.34;letter-spacing:-.014em;color:#1a2b25;margin:0 0 13px}
.author-line{font-size:12.5px;color:#344a40;line-height:1.6;margin:0 0 16px}
.work-desc{font-size:14px;line-height:1.78;color:#25382f;margin:0 0 17px}
.linkline{display:flex;gap:20px;flex-wrap:wrap;font-size:13px}.linkline a{border-bottom:1px solid #96aba5;padding-bottom:1px}
.work-art{margin:0;min-width:0}
.work-art img{display:block;width:100%;height:auto;border:1px solid #d8ddd7;box-shadow:0 7px 28px #3948420c}
.work-art figcaption{font-size:11px;color:#42574b;line-height:1.45;margin-top:9px}
.publications{padding-top:32px;margin-top:24px;border-top:1px solid var(--line)}
.paper-list{margin:0;padding:0;list-style:none}
.paper-list li{display:grid;grid-template-columns:58px 1fr;gap:20px;padding:13px 0 16px;border-bottom:1px solid #e4e7e2}
.paper-list li:last-child{border:0}
.paper-list .year{font-size:12px;color:#3b5147;padding-top:3px;letter-spacing:.03em}
.paper-list .ptitle{font-size:14px;font-weight:700;line-height:1.5;color:#1d3028;margin:0 0 4px}
.paper-list .pdetail{font-size:12.5px;color:#344a40;line-height:1.65;margin:0}
.paper-list .pdetail a{white-space:nowrap}
.awards{padding-top:36px;margin-top:25px;border-top:1px solid var(--line)}
.award-list{display:grid;grid-template-columns:1fr;gap:10px;font-size:13.5px}
.award-row{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #e7e9e5;padding-bottom:10px}
.award-row span:last-child{font-size:12px;color:#3d5549;white-space:nowrap}
.footer{border-top:1px solid var(--line);padding:23px 0 26px;color:#43584c;font-size:11px}
@media(max-width:1030px){.wrapper{padding-left:33px;padding-right:33px}.hero{grid-template-columns:280px 1fr;gap:48px}.work{grid-template-columns:minmax(0,1fr) 42%;gap:35px}.work + .work{grid-template-columns:42% minmax(0,1fr)}.work-title{font-size:22px}}
@media(max-width:720px){body{font-size:14px}.wrapper{padding-left:22px;padding-right:22px}.navbar{min-height:65px;align-items:flex-start;padding-top:18px;padding-bottom:13px;flex-direction:column;gap:14px}.wordmark{font-size:21px}.navigation{gap:20px;font-size:12px}.main{padding-top:40px}.hero{grid-template-columns:1fr;gap:20px;padding-bottom:40px}.hero-title{font-size:44px}.name-cn{font-size:21px;margin:11px 0 12px}.position{margin:0 0 12px}.bio{font-size:14px}.research{padding-top:35px}.section-title{font-size:29px}.work,.work+.work{display:flex;flex-direction:column;gap:19px;align-items:stretch;padding:22px 0 31px}.work--reverse .work-content{order:0}.work--reverse .work-art{order:1}.work-title{font-size:22px}.work-desc{font-size:13.7px}.work-art img{max-width:560px}.work-art figcaption{font-size:10.5px}.publications,.awards{padding-top:28px;margin-top:18px}.paper-list li{gap:12px;grid-template-columns:40px 1fr}.award-row{display:block}.award-row span:last-child{display:block;margin-top:2px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.additional-section{padding-top:34px;margin-top:25px;border-top:1px solid var(--line)}
.info-list{display:grid;gap:13px;font-size:13.5px}
.info-row{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid #e7e9e5;padding-bottom:11px}
.info-row:last-child{border-bottom:none}
.info-row p{margin:0;line-height:1.65}
.info-row .info-role{font-weight:600;color:var(--ink)}
.info-row .info-note{color:#3e5449;font-size:12px;margin-top:2px}
.info-row .info-date{font-size:12px;color:#3d5549;white-space:nowrap}
@media(max-width:720px){.additional-section{padding-top:28px;margin-top:18px}.info-row{display:block}.info-row .info-date{display:block;margin-top:4px}}


/* Research dialog layout: authentic chat shell for CCS, investigative notebook for IWQoS */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.art-open{position:relative;display:block;width:100%;padding:0;border:0;background:transparent;cursor:pointer;text-align:left}
.art-open img{display:block;width:100%;transition:transform .18s ease,box-shadow .18s ease}
.art-open:hover img,.art-open:focus-visible img{box-shadow:0 11px 28px #1e352525;transform:translateY(-2px)}
.art-corner{position:absolute;right:12px;bottom:12px;padding:5px 9px;background:#fffdf8;border:1px solid #b7c3bc;color:#24382f;font-size:11px;font-weight:700;line-height:1.3}
.text-open{font:inherit;color:#214e5c;background:none;border:0;border-bottom:1px solid currentColor;cursor:pointer;padding:0 0 1px;text-align:left}
.text-open:hover{color:#0e3445}
.art-open:focus-visible,.text-open:focus-visible,.close-detail:focus-visible,.prompt-chip:focus-visible,.section-link:focus-visible,.vs-section button:focus-visible,.case-step:focus-visible,.aside-toggle:focus-visible,.mini-quiz button:focus-visible,.vs-send:focus-visible{outline:3px solid #809fbe;outline-offset:3px}
.detail-dialog{width:min(1100px,calc(100vw - 30px));max-height:92dvh;overflow:auto;overscroll-behavior:contain;margin:auto;padding:0;border:1px solid #b1bfc9;background:white;color:#1b292e;box-shadow:0 16px 80px #10202c59;border-radius:8px}
.detail-dialog::backdrop{background:rgba(16,24,32,.60)}
.detail-dialog *{box-sizing:border-box}
.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;padding:20px 26px 15px;background:#fff;border-bottom:1px solid #d9e0e8}
.dialog-overline{font-size:10.5px;letter-spacing:1px;text-transform:uppercase;font-weight:800;color:#385b83;margin:0 0 5px}
.dialog-head h2{font:500 27px/1.24 Georgia,"Times New Roman",serif;letter-spacing:-.02em;color:#1d2b33;margin:0 0 6px}
.dialog-head p:last-child{font-size:12px;line-height:1.5;color:#3d4e60;margin:0;max-width:760px}
.close-detail{flex:0 0 33px;width:33px;height:33px;background:#fff;color:#1d3139;border:1px solid #b8c6cf;border-radius:4px;cursor:pointer;font-size:20px;line-height:1}
.dialog-main{padding:18px 24px 20px}
.dialog-foot{padding:11px 25px;background:#f5f7fb;border-top:1px solid #dae2eb;font-size:11.3px;line-height:1.5;color:#334b63}
.demo-flag{display:inline-block;background:#e8f0ff;border:1px solid #bfd0ec;border-radius:3px;padding:2px 7px;font:700 10.5px/1.5 Arial,sans-serif;color:#274e85;margin:0 8px 0 0}
/* CCS - cool blue chat-first mockup */
#detail-ccs{--vs-ink:#1d354e;--vs-sub:#3e5672;--vs-edge:#cedbec;--vs-accent:#315fba;--vs-light:#f3f7ff;border-color:#94b0d3}
#detail-ccs .dialog-head{background:#f8fbff}
.vs-window{border:1px solid #bdcfe4;background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 2px 11px #42658b11}
.vs-bar{display:flex;align-items:center;justify-content:space-between;padding:8px 13px;background:#e9f1fc;border-bottom:1px solid #cbd8e9;gap:12px;font-size:12px;color:#1f3a58}
.vs-brand{font-weight:800;letter-spacing:.1px}
.vs-status{font-size:10px;color:#3d5b77;background:#fff;border:1px solid #b7c9e0;padding:2px 7px;border-radius:3px}
.vs-columns{display:grid;grid-template-columns:150px minmax(0,1fr) 188px;min-height:510px}
.vs-history{background:#f3f7ff;border-right:1px solid #d2deec;padding:17px 12px}
.vs-microhead{font:800 10px/1.5 Arial,sans-serif;letter-spacing:.8px;color:#4b6083;text-transform:uppercase;margin:0 0 13px}
.vs-history a{display:block;border:0;font-size:11.3px;line-height:1.45;color:#304762;text-decoration:none;padding:9px 8px;margin-bottom:3px;border-radius:3px}
.vs-history a.active{background:#dfebfb;color:#204c83;font-weight:700}
.vs-center{padding:17px 18px 12px;min-width:0;background:#fff;display:flex;flex-direction:column}
.vs-thread{flex:1}
.vs-user{margin:0 0 13px auto;max-width:90%;background:#e7f0ff;color:#23466e;border:1px solid #c6d9f4;border-radius:10px 10px 3px 10px;padding:10px 13px;font-size:12.3px;font-weight:650;line-height:1.5}
.vs-assistant{font-size:12px;color:#284153}
.vs-assistant-title{font-weight:800;font-size:11.5px;color:#28455e;margin:0 0 8px}
.vs-section{border:1px solid #d4dfeb;border-radius:4px;margin:0 0 6px;background:#fff}
.vs-section.open{background:#f9fbff;border-color:#bad0ea}
.vs-section button{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;cursor:pointer;background:transparent;padding:9px 10px;border:0;text-align:left;color:#233b59;font:700 11.7px/1.4 Arial,sans-serif}
.vs-section .chevron{font-size:16px;font-weight:400;color:#476994}
.vs-section p{padding:0 10px 10px;margin:0;color:#354d62;font-size:11.5px;line-height:1.6}
.vs-section p[hidden]{display:none}
.vs-suggestions{border-top:1px solid #e0e6ee;margin-top:10px;padding:10px 0 0}
.vs-suggestions p{font-size:10.2px;font-weight:700;color:#526885;margin:0 0 6px}
.vs-chipline{display:flex;flex-wrap:wrap;gap:5px}
.prompt-chip{font:500 10.4px/1.45 Arial,sans-serif;color:#22538a;background:#f4f8fe;border:1px solid #c5d7ed;border-radius:16px;padding:5px 8px;cursor:pointer;text-align:left}
.prompt-chip:hover{background:#dfefff}
.vs-composer{border:1px solid #aabfda;border-radius:4px;display:flex;align-items:center;gap:8px;margin-top:11px;padding:5px 5px 5px 10px;background:#fff}
.vs-composer input{border:0;outline:none;min-width:0;flex:1;color:#1f3750;font:11.5px Arial,sans-serif;background:transparent}
.vs-send{border:0;border-radius:3px;color:white;background:#336ac5;padding:6px 11px;font:700 10.5px Arial,sans-serif;cursor:pointer}
.vs-notice{min-height:18px;font-size:10px;color:#385b82;line-height:1.5;padding-top:4px;margin:0}
.vs-side{background:#f9fbfe;border-left:1px solid #d8e2ef;padding:17px 12px;min-width:0}
.section-link{display:block;width:100%;text-align:left;background:none;border:0;border-radius:3px;padding:7px 5px;color:#395572;cursor:pointer;font:11px/1.4 Arial,sans-serif}
.section-link:hover{background:#e5edf8;color:#214b83}
.aside-toggle{display:block;width:100%;padding:10px 9px;margin-top:18px;background:#e6efff;border:1px solid #afc9f1;border-radius:4px;color:#214f96;font:800 11px Arial,sans-serif;text-align:left;cursor:pointer}
.aside-toggle[aria-expanded="true"]{background:#d6e6fe;border-color:#6e9bdc}
.mini-quiz{margin-top:10px;padding:10px;border:1px solid #bfcfe5;background:#fff;border-radius:3px}
.mini-quiz[hidden]{display:none}
.mini-quiz p{margin:0 0 8px;font-size:11px;line-height:1.45;color:#203b59}
.mini-quiz button{display:block;width:100%;font:10px/1.4 Arial,sans-serif;cursor:pointer;background:#f7f9fc;border:1px solid #c9d7e7;padding:7px;margin-bottom:6px;text-align:left;color:#2d4964}
.mini-quiz button:hover{background:#e5f0ff}
.mini-quiz .quiz-feedback{margin:6px 0 0;font-size:10px;color:#23518b;font-weight:700}
/* IWQoS - warm field notebook, no fabricated transcript */
#detail-iwqos{border-color:#c7a78c;color:#3a2b26}
#detail-iwqos .dialog-head{background:#fff8f0;border-color:#ead9c8}
#detail-iwqos .dialog-overline{color:#87513b}
#detail-iwqos .dialog-head h2{color:#3e2d27}
#detail-iwqos .dialog-head p:last-child{color:#644c3e}
#detail-iwqos .dialog-main{background:#fffaf4}
#detail-iwqos .dialog-foot{background:#fff5ea;border-color:#ead9c8;color:#704e40}
.case-stage{display:grid;grid-template-columns:235px minmax(0,1fr);gap:18px}
.case-nav{background:#f9f0e8;border:1px solid #dfc6b2;border-radius:5px;padding:12px}
.case-label{font:800 10px/1.5 Arial,sans-serif;letter-spacing:1px;color:#855940;margin:0 0 10px;text-transform:uppercase}
.case-step{display:flex;align-items:center;gap:9px;width:100%;border:0;text-align:left;padding:11px 8px;border-left:3px solid transparent;cursor:pointer;background:transparent;font:700 11.5px Arial,sans-serif;color:#644638}
.case-step:hover{background:#f3e4d7}
.case-step[aria-current="step"]{background:#e9d2be;border-left-color:#b76e4f;color:#4f2b1f}
.case-no{font:700 11px Arial,sans-serif;min-width:24px;color:#99583e}
.case-sheet{background:#fffcf8;border:1px solid #dcc9b7;box-shadow:6px 6px 0 #f1e1d2;border-radius:3px;min-height:358px;padding:23px 25px 17px;position:relative}
.case-sheet:before{content:"";position:absolute;top:11px;right:14px;width:49px;height:22px;border:2px solid #cd9e87;transform:rotate(-9deg);border-radius:2px;opacity:.45}
.case-meta{font:800 10px Arial,sans-serif;color:#9c6045;letter-spacing:1px;text-transform:uppercase;margin:0 0 11px}
.case-sheet h3{font:500 24px Georgia,"Times New Roman",serif;color:#442c25;margin:0 0 12px}
.case-bodytext{font-size:13px;line-height:1.75;color:#523e32;max-width:630px;margin:0 0 14px}
.case-observation{padding:12px 15px;border-left:3px solid #b67752;background:#f9eee3;font-size:12px;line-height:1.6;color:#573d2e;margin:16px 0 0}
.case-content[hidden]{display:none}
.case-evidence{border-top:1px dashed #d6b8a0;margin-top:26px;padding-top:13px;display:flex;gap:11px;flex-wrap:wrap}
.case-pill{padding:6px 9px;background:#f4e7da;color:#7c472e;border:1px solid #e5c8ae;border-radius:2px;font:700 10.5px Arial,sans-serif}
.case-mini-stats{display:flex;gap:18px;margin:15px 0 0;flex-wrap:wrap;font-size:12px;color:#6a4b3c}
.case-mini-stats strong{color:#a25539;font:700 16px Georgia,serif}
@media(max-width:840px){.vs-columns{grid-template-columns:105px minmax(0,1fr) 142px}.vs-history{padding:12px 6px}.vs-center{padding:13px}.vs-side{padding:12px 8px}}
@media(max-width:680px){.dialog-head{padding:15px 17px 12px}.dialog-head h2{font-size:22px}.dialog-main{padding:11px}.dialog-foot{padding:12px 15px}.vs-columns{grid-template-columns:minmax(0,1fr)}.vs-history{display:none}.vs-side{grid-row:2;border-left:0;border-top:1px solid #d8e2ef;display:block}.vs-side .section-link{display:inline-block;width:auto;padding:5px 7px}.vs-side .vs-microhead{margin:0 0 4px}.vs-center{min-height:410px}.vs-user{max-width:95%}.case-stage{grid-template-columns:1fr;gap:10px}.case-nav{display:flex;overflow-x:auto;gap:3px;padding:6px}.case-nav .case-label{display:none}.case-step{flex:0 0 auto;padding:8px 7px;font-size:10px}.case-sheet{padding:18px;min-height:330px}.case-sheet h3{font-size:21px}.case-bodytext{font-size:12.5px}}
@media(prefers-reduced-motion:reduce){.art-open img{transition:none}}

/* Preset-only demo: real clickable examples, no input controls */
.vs-bar-sub{font-weight:400;color:#344b68}
.vs-columns{min-height:445px}
.vs-history button{display:block;width:100%;border:0;font-size:11.3px;line-height:1.45;color:#304762;text-decoration:none;padding:9px 8px;margin-bottom:3px;border-radius:3px;background:transparent;text-align:left;cursor:pointer;font-family:Arial,sans-serif}
.vs-history button:hover{background:#e8f0fc}
.vs-history button.active{background:#dfebfb;color:#204c83;font-weight:700}
.vs-lead{font-size:11.7px;line-height:1.6;margin:0 0 12px;color:#304c68}
.vs-center{padding-bottom:18px}
.vs-suggestions{padding:14px 0 0;margin-top:15px}
.prompt-chip[aria-pressed="true"]{background:#dce9ff;border-color:#769ddd;color:#193d76;font-weight:700}
.case-sheet{min-height:265px;display:flex;flex-direction:column}
.case-content{flex:1}
.case-progress{display:flex;gap:7px;margin-top:auto;padding-top:26px}
.case-progress span{height:4px;flex:1;border-radius:2px;background:#e8d8ca}
.case-progress span.active{background:#b56d4d}
#detail-ccs .dialog-foot{color:#334960}
#detail-iwqos .dialog-foot{color:#634536}
@media(max-width:680px){.vs-history{display:none}.vs-columns{min-height:0}.vs-center{min-height:350px}.case-sheet{min-height:235px}}


/* Click-only preview: no input, empty until a question is selected */
.vs-columns{min-height:460px}
.vs-center{min-height:420px}
.vs-thread{flex:1;min-height:245px;max-height:365px;overflow:auto;scroll-behavior:smooth;padding-right:3px}
.vs-empty{display:flex;align-items:center;justify-content:center;min-height:250px;color:#536781;font:12px/1.5 Arial,sans-serif;text-align:center}
.vs-history-heading{display:flex;align-items:start;justify-content:space-between;gap:5px}
.vs-history-empty{color:#61738a;font-size:11px;line-height:1.5;margin:1px 4px}
.vs-history button.vs-history-item{display:block;width:100%;border:0;border-radius:3px;background:transparent;color:#304762;padding:9px 8px;text-align:left;font:11.2px/1.5 Arial,sans-serif;cursor:pointer;margin:0 0 3px}
.vs-history button.vs-history-item:hover{background:#e9f1fb}
.vs-history button.vs-history-item.active{background:#dfebfb;color:#204c83;font-weight:700}
.vs-history button.vs-clear{width:auto;border:0;border-bottom:1px solid #7795b9;padding:0 0 2px;color:#315c8e;background:none;font:10px/1.5 Arial,sans-serif;cursor:pointer}
.vs-clear[hidden]{display:none!important}
.vs-turn{padding:0 0 18px;margin:0 0 17px;border-bottom:1px solid #e4eaf2}
.vs-turn:last-child{border-bottom:0}
.vs-lead{font-size:11.7px;line-height:1.65;margin:0 0 13px;color:#304c68}
.vs-suggestions{padding:14px 0 0;margin-top:12px}
.vs-side button:disabled{opacity:.48;cursor:default}
.vs-side button:disabled:hover{background:transparent}
.vs-section{margin-bottom:6px}
#detail-ccs .dialog-foot{color:#334960}
